<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No device backup: the data lives in Supabase, and a backup would copy the sign-in session and health data. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The sign-in link in the email opens the app: io.github.raja2102598.gymlog://login?code=…
                 The home-screen widget's taps open it the same way: .../go/today, .../go/weight or .../go/steps
                 (GymWidgetProvider builds them; src/native/app.ts and GymLog.tsx turn one into the matching screen). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- One scheme, two hosts: Android combines a data tag's attributes across all of an
                     intent-filter's data tags, so this scheme applies to both. -->
                <data android:scheme="@string/custom_url_scheme" />
                <data android:host="login" />
                <data android:host="go" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- The home-screen widget (GymWidgetProvider): today's session and lift progress, from WidgetPlugin.
             android:exported="false" is right even so: APPWIDGET_UPDATE is a protected, system-only broadcast, so
             only Android itself can deliver it, home screens included. -->
        <receiver
            android:name=".GymWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/gym_widget_info" />
        </receiver>
        <!-- The rest timer's alarm (RestAlarm.kt, RestTimerPlugin.kt): fires even if Gym Log isn't running, so it's
             named here rather than only registered in code. Only this app's own PendingIntent triggers it. -->
        <receiver
            android:name=".RestTimerReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Self-updating (AppUpdatePlugin): lets the app ask to launch Android's installer for its own downloaded
         APK. Android still shows its one-time "allow installs from Gym Log" screen before the first install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Voice logging (SpeechPlugin): the microphone, asked for when Log sets by voice is switched on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 11 and later only let an app see the services it names here: without this, the phone's speech
         recognition looks missing. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Rest timer (RestTimerPlugin.kt, RestAlarm.kt): a notification at zero while the app is backgrounded or
         closed. POST_NOTIFICATIONS is Android 13 and later's runtime permission for posting one at all, asked for
         from the Settings row it's named after; older versions grant it on install. SCHEDULE_EXACT_ALARM lets the
         alert land on time rather than whenever Doze next lets an inexact one through, which the code falls back to
         where this isn't granted (from Android 12, only "Alarms & reminders" in the phone's own settings grants it;
         it isn't automatic there the way it is on 12 itself). USE_EXACT_ALARM would need Gym Log to be an alarm or
         calendar app, which it isn't, so this is the declaration for the ordinary, sometimes-not-granted kind. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The page's own buzz at zero (navigator.vibrate) while the app is open: the WebView needs this to do it. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Health Connect: Gym Log only reads. What it reads is READ in src/native/health.ts; older history too. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Background sync (HealthSyncWorker) reads while the app is closed, where Health Connect supports it. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- The plugin declares every type it supports, reading and writing; drop what Gym Log doesn't use: all writing,
         and blood glucose, temperatures and mindfulness. -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove" />
</manifest>
