<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: tokens.css's own dark values, so the widget follows the home screen's theme like a well-behaved
     widget should, even though the app's WebView (Settings' own light/dark/system choice) doesn't read this file. -->
<resources>
    <color name="widget_background">#1B1E23</color>
    <color name="widget_ink">#ECEEF1</color>
    <color name="widget_muted">#9AA2AE</color>
    <color name="widget_chip_background">#24282E</color>
</resources>
