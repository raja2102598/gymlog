<?xml version="1.0" encoding="utf-8"?>
<!-- The rest timer's notification icon (RestAlarm.kt): a stopwatch, as a plain white silhouette. Android draws a
     notification's small icon from its alpha channel alone and tints it itself, so only the shape matters. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The button on top. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,1L14,1L14,3L10,3Z" />
    <!-- The case, as a ring so the hand inside it still reads. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M3,12 A9,9 0 1,0 21,12 A9,9 0 1,0 3,12 Z M5,12 A7,7 0 1,0 19,12 A7,7 0 1,0 5,12 Z" />
    <!-- The hand, part way round rather than at twelve, so it reads as counting rather than stopped. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.25,6L12.75,6L12.75,12.75L11.25,12.75Z" />
</vector>
