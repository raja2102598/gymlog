{
  "name": "gym-log",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sw.mjs",
    "preview": "node scripts/serve.mjs out 3000",
    "android": "npm run build && cap sync android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "test:e2e": "node tests/e2e/run.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capgo/capacitor-health": "8.11.4",
    "@supabase/supabase-js": "2.117.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  }
