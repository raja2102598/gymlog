# Where a build of Gym Log points. Every build needs these: without them the app shows its setup screen instead of
# signing in. Nothing here is secret: the values ship in the site's JavaScript and in the APK, where anyone can read
# them (src/lib/config.ts explains).
#
# For `npm run dev` and `npm run build`, copy this file to .env.local (git ignores it) and fill it in. On Vercel, add
# them under Settings -> Environment Variables. For the Android workflow, add them as repository variables (Settings
# -> Secrets and variables -> Actions -> Variables). Next.js reads them when it builds, not when it runs.

# Supabase -> Project Settings -> API: the project URL and its publishable key. Never the secret / service_role key.
# (Vercel's Supabase integration sets the key as NEXT_PUBLIC_SUPABASE_ANON_KEY; that name works too.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The site's address, e.g. https://my-gym-log.vercel.app. Sign-in links asked for in the Android app land on
# <site>/app-login.html, so the address (followed by /**) must be an allowed redirect URL in Supabase
# (Authentication -> URL Configuration).
NEXT_PUBLIC_SITE_URL=

# Continue with Google in the Android app: the OAuth *Web* client ID from Google Cloud (README -> Continue with
# Google). Leave it empty to keep the app's Google button hidden.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
